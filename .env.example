DB_PATH=gatekeeper.db

# Required for POST /session/approve to work at all. Fails closed if unset —
# approval is refused entirely, never silently allowed. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEKEEPER_OPERATOR_TOKEN=

# Optional but strongly recommended. Without it, the audit hash on every
# signed report is a plain SHA-256 that anyone with database access can
# recompute to match tampered data. With it, the hash becomes a keyed
# HMAC-SHA256 that cannot be forged without this exact key. The key must
# never be stored in the database or in any report file, only here.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
GATEKEEPER_AUDIT_KEY=
